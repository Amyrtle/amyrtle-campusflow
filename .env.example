# Copy to .env; never commit .env or paste its secrets into chat.
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
AUTH_MODE=local
DATA_DIR=.data/postgres
MOCK_AI_MODE=true

# Production common settings: inject real values via the deployment environment.
# NODE_ENV=production
# AUTH_MODE=cloudbase
# HOST=0.0.0.0
# PORT=9000  # HTTP function; use 3001 for the provided CloudRun container.
# APP_ORIGIN=https://your-frontend.example
# CORS_MANAGED_BY_GATEWAY=true  # Only when the CloudBase HTTP gateway supplies CORS headers.
# TICKET_SECRET=replace-with-at-least-32-random-characters
# CLOUDBASE_ENV_ID=

# Choose ONE database transport. Never expose either credential to the browser.
# Shared CloudBase PG (user-approved deployment path):
# DATABASE_MODE=cloudbase-http
# CLOUDBASE_DATABASE_API_KEY=
# Apply all versioned SQL migrations with authorized CloudBase management tools.
# Native PostgreSQL alternative: leave DATABASE_MODE unset.
# DATABASE_URL=postgresql://app_user:password@host:5432/postgres
# DATABASE_SSL=true

# Optional live AI: leave MOCK_AI_MODE=true until model access is verified.
# This AI key and the database key are separate service configuration values.
# CLOUDBASE_API_KEY=
# CLOUDBASE_AI_MODEL=

# Frontend build-time configuration is public; rebuild after changing it.
# VITE_CLOUDBASE_ENV_ID=
# VITE_CLOUDBASE_REGION=ap-shanghai
# Public CloudBase publishable key only, never a server API key or SecretKey.
# VITE_PUBLISHABLE_KEY=
# VITE_API_BASE_URL=https://your-api-host.example
